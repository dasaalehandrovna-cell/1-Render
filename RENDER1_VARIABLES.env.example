# Render #1 — FAST Telegram front
APP_URL=https://fo-ug7k.onrender.com
WEBHOOK_URL=https://fo-ug7k.onrender.com
PORT=5000
BOT_SPLIT_ROLE=front
RENDER_TELEGRAM_ONLY=1

# Telegram / owner — copy your current values
B_T=<CURRENT_BOT_TOKEN>
ID=<CURRENT_ID>
OWNER_ID=<CURRENT_OWNER_ID>
BACKUP_CHAT_ID=<CURRENT_BACKUP_CHAT_ID>
QUICK_EXPENSE_CHAT_ID=<CURRENT_QUICK_EXPENSE_CHAT_ID>
QUICK_EXPENSE_KEY=<CURRENT_QUICK_EXPENSE_KEY>
QUICK_EXPENSE_REMINDER_MINUTES=60

# SAME Render Redis/Key Value on BOTH services
REDIS_URL=<CURRENT_REDIS_URL>
WORKER_REDIS_SNAPSHOT_KEY=vys262:bot_state:latest_gz
WORKER_REDIS_SNAPSHOT_MAX_MB=16

# Render #2 connection
PEER_SERVICE_URL=https://render-2-worker-mega.onrender.com
PEER_SHARED_SECRET=<SAME_LONG_SECRET_ON_BOTH_RENDERS>
PEER_PING_ENABLED=1
SPLIT_WORKER_SYNC_ENABLED=1
SPLIT_STATE_SYNC_DELAY_SEC=0.6
SPLIT_STATE_SYNC_MIN_INTERVAL_SEC=5

# Startup restore / rolling deploy handoff
SPLIT_BOOT_ALWAYS_RESTORE=1
SPLIT_BOOT_HANDOFF_GRACE_SEC=10
SPLIT_BOOT_WORKER_ATTEMPTS=3
SPLIT_BOOT_WORKER_TIMEOUT=12
SPLIT_RESTORE_RETRY_SEC=20
SPLIT_FORCE_BOOT_RESTORE=0
SPLIT_ALLOW_EMPTY_BOOT=0
SPLIT_EMERGENCY_MEGA=1

# Normal MEGA runtime is OFF on front; credentials are emergency restore only
MEGA_ENABLED=0
MEGA_AUTORESTORE=0
TG_DURABLE_ENABLED=0
MEGA_EMAIL=<CURRENT_MEGA_EMAIL>
MEGA_PASSWORD=<CURRENT_MEGA_PASSWORD>
MEGA_SESSION=
MEGA_BACKUP_DIR=/TelegramBotBackups2-2
MEGA_LEGACY_BACKUP_DIRS=/TelegramBotBackups-2T,/TelegramBotBackups
MEGA_TIMEOUT=120
MEGA_LOGIN_TIMEOUT=120

# Google private key MUST NOT be on Render #1
SPLIT_GOOGLE_REMOTE_ENABLED=1
GOOGLE_SHEETS_SPREADSHEET_ID=
MALLOC_ARENA_MAX=2
