# Render #1 — FAST Telegram front — R14
# Internal numeric/tuning values are packaged in runtime_config.py.
# Keep only credentials, remote addresses and external Telegram/resource identifiers here.

# Public service addresses
APP_URL=https://fo-ug7k.onrender.com
WEBHOOK_URL=https://fo-ug7k.onrender.com
PEER_SERVICE_URL=https://render-2-worker-mega.onrender.com

# Telegram credentials / external identifiers
B_T=<CURRENT_BOT_TOKEN>
ID=<CURRENT_OWNER_ID>
OWNER_ID=<CURRENT_OWNER_ID>
BACKUP_CHAT_ID=<CURRENT_BACKUP_CHAT_ID>
QUICK_EXPENSE_CHAT_ID=<CURRENT_QUICK_EXPENSE_CHAT_ID>
